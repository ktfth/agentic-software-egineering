{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "labs/**/*.ts",
    "tests/**/*.ts"
  ]
}
