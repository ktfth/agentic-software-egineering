{
  "name": "agentic-software-engineering-code",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "labs/*/starter",
    "labs/*/solution"
  ],
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "validate": "npm test",
    "sentinel": "node dist/apps/sentinel/src/cli.js",
    "lab": "npm run build && node scripts/run-lab.mjs",
    "verify:labs": "node scripts/verify-labs.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.0"
  }
}
